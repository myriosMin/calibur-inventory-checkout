# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Telegram ---
# Server-only. Signs/validates initData and webhook calls to the Bot API.
TELEGRAM_BOT_TOKEN=
# Compared against the X-Telegram-Bot-Api-Secret-Token header on /api/tg/webhook.
TELEGRAM_WEBHOOK_SECRET=
# Public: used to build https://t.me/<bot>/<app>?startapp=<code> deep links.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_MINIAPP_NAME=

# --- Supabase ---
# Server-only service-role key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Scheduled notifications (/api/cron/daily) ---
# Server-only. Guards the cron route, which is a PUBLIC URL -- Vercel's scheduler
# calls it with `Authorization: Bearer <this>`. Unset means every request is
# rejected (fails closed), so the job goes silent rather than open.
CRON_SECRET=
# Telegram chat the low-stock / data-check / weekly-digest messages post to.
# A club GROUP id (negative, usually starting -100), NOT a person's chat: a
# committee handover should not take the alerts with the outgoing logistics
# lead. Find it with `npx tsx scripts/get-chat-id.ts`. Unset = those messages
# are skipped; the cron still runs and still purges. Never NEXT_PUBLIC_.
TELEGRAM_ALERT_CHAT_ID=
# Days a member may hold a returnable/asset item before the bot mentions it.
# Optional; defaults to 21 (flows.md §7's "out for 3 weeks"). Re-nudges are
# capped at one per week per item regardless of this value.
OVERDUE_THRESHOLD_DAYS=

# --- Dev-only mocks (never enable in production) ---
# Set to "1" to let /store run outside a real Telegram WebView using a signed mock initData string.
NEXT_PUBLIC_ENABLE_DEV_MOCKS=
# Output of `npx tsx scripts/dev-mock-init-data.ts <telegram_user_id>`.
NEXT_PUBLIC_DEV_MOCK_INIT_DATA=
