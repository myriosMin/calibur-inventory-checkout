# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Telegram ---
# Server-only. Signs/validates initData and webhook calls to the Bot API.
TELEGRAM_BOT_TOKEN=
# Compared against the X-Telegram-Bot-Api-Secret-Token header on /api/tg/webhook.
TELEGRAM_WEBHOOK_SECRET=
# Public: used to build https://t.me/<bot>/<app>?startapp=<code> deep links.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_MINIAPP_NAME=

# --- Supabase ---
# Server-only service-role key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Dev-only mocks (never enable in production) ---
# Set to "1" to let /store run outside a real Telegram WebView using a signed mock initData string.
NEXT_PUBLIC_ENABLE_DEV_MOCKS=
# Output of `npx tsx scripts/dev-mock-init-data.ts <telegram_user_id>`.
NEXT_PUBLIC_DEV_MOCK_INIT_DATA=
